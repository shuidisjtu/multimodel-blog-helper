# Unify line endings: git normalizes to LF on both checkin and checkout.
# Windows editors/tools may write CRLF; without this, biome's byte-level
# check fails locally while git status stays clean (autocrlf hides it).
* text=auto
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
