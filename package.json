{
  "name": "multimodel-blog-helper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenAI 多模态博客助手:音频转录 + 摘要 + 天气工具调用 HTTP 服务(学习研究项目)",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src tests scripts",
    "lint:fix": "biome check --write src tests scripts",
    "check:docs": "tsx scripts/check-docs.ts",
    "check:structure": "tsx scripts/generate-structure.ts --check",
    "structure:update": "tsx scripts/generate-structure.ts --update",
    "verify": "npm run lint && npm run typecheck && npm run check:docs && npm run check:structure && npm test && npx vitest run --coverage",
    "dev": "tsx watch src/bootstrap/server.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "music-metadata": "^11.15.0",
    "openai": "^7.4.0"
  }
}
