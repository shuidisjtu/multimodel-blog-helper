# 运行环境
NODE_ENV=development
PORT=3000

# 摘要域: OpenAI 兼容网关(openai-hk 中转站)。转录已迁至下方的百炼转录域
OPENAI_API_KEY=hk-xxx
OPENAI_BASE_URL=https://api.openai-hk.com/v1
OPENAI_SUMMARY_MODEL=gpt-4o
OPENAI_SUMMARY_TIMEOUT_MS=60000
OPENAI_MAX_RETRIES=2

# 转录域: 阿里云百炼(DashScope, 国内站)。配置项与摘要域互相独立, 但本服务同时提供
# 转录与摘要, 两域凭证均为必填(缺失时启动即失败, 报错只指向自己缺失的变量名)
# Key 在百炼控制台创建, 严禁提交到仓库
DASHSCOPE_API_KEY=sk-xxx
# 同步识别端点。默认通用域名可直接用; 但 DashScope 域名(dashscope.aliyuncs.com)
# 自 2026-09-30 起不再支持新特性(存量业务仍兼容), 正式/演示环境请改用业务空间专属域名:
#   https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
# WorkspaceId 取自百炼控制台「业务空间管理」的 API Host 列。仅域名变化, 路径不变。
QWEN_ASR_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
QWEN_ASR_MODEL=qwen-audio-3.1-asr-flash
# 转录上游超时(毫秒, 默认 300000 = 5 分钟)
QWEN_ASR_TIMEOUT_MS=300000
# 说话人分离(默认 true): 开启后返回多段句子并带 speaker_id, 时间戳分段按说话人边界断开
QWEN_ASR_SPEAKER_DIARIZATION=true
QWEN_ASR_MAX_RETRIES=2

# 本地存储策略
TEMP_DIR=temp
# 上传大小上限(字节, 默认 15 MiB)。base64 膨胀 4/3, 15 MiB 编码后约 20 MiB,
# 恰为 DashScope 对单个 data-uri 的实测上限(20971520 字节), 超限在受理阶段即拒
MAX_UPLOAD_BYTES=15728640
JOB_TTL_HOURS=24
# tombstone 二次清理保留天数(默认 30)
TOMBSTONE_RETENTION_DAYS=30
# 过期清理周期(毫秒, 默认 1 小时)
CLEANUP_INTERVAL_MS=3600000

# wttr.in 天气适配器
WEATHER_BASE_URL=https://wttr.in
WEATHER_TIMEOUT_MS=15000

# 队列与限流(B6: 每 IP 每 60 秒次数)
MAX_QUEUE_LENGTH=100
WORKER_CONCURRENCY=1
RATE_LIMIT_UPLOAD_PER_MINUTE=10
RATE_LIMIT_WEATHER_PER_MINUTE=30
METRICS_PORT=9100

# 安全(B6): 部署在反向代理后时设为 true, 限流按 X-Forwarded-For 首段计 IP; 默认 false(只用 socket 地址, 不信任伪造头)
TRUST_PROXY=false
# CORS 白名单(B6): 逗号分隔 Origin(如 https://app.example.com,https://admin.example.com); 留空 = 仅同源(不返回 CORS 允许头); 禁止 "*"
CORS_ALLOWED_ORIGINS=

# 时长上限(受理时 music-metadata 检测,秒; 默认 300 = DashScope 同步识别实测硬限)
MAX_AUDIO_DURATION_SECONDS=300

# 日志
LOG_LEVEL=info
