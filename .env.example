# 运行环境
NODE_ENV=development
PORT=3000

# OpenAI 兼容网关(openai-hk 中转站)
OPENAI_API_KEY=hk-xxxx
OPENAI_BASE_URL=https://api.openai-hk.com/v1
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_SUMMARY_MODEL=gpt-4o
OPENAI_TRANSCRIBE_TIMEOUT_MS=600000

# 本地存储策略
TEMP_DIR=temp
MAX_UPLOAD_BYTES=26214400
JOB_TTL_HOURS=24

# wttr.in 天气适配器
WEATHER_BASE_URL=https://wttr.in
WEATHER_TIMEOUT_MS=15000

# 队列与限流
MAX_QUEUE_LENGTH=100
WORKER_CONCURRENCY=1
RATE_LIMIT_UPLOAD_PER_MINUTE=10
RATE_LIMIT_WEATHER_PER_MINUTE=30
METRICS_PORT=9100

# 时长上限(受理时 ffprobe 检测,秒)
MAX_AUDIO_DURATION_SECONDS=3600

# 日志
LOG_LEVEL=info
